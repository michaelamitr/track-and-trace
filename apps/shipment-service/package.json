{
  "name": "@tt/shipment-service",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=../../.env src/main.ts",
    "start": "tsx --env-file=../../.env src/main.ts",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "typecheck": "tsc --noEmit",
    "db:migrate": "tsx --env-file=../../.env src/db/migrate-cli.ts up",
    "db:migrate:down": "tsx --env-file=../../.env src/db/migrate-cli.ts down"
  },
  "dependencies": {
    "@fastify/swagger": "^9.9.3",
    "@fastify/swagger-ui": "^6.1.3",
    "@nats-io/jetstream": "^3.4.0",
    "@nats-io/transport-node": "^3.4.0",
    "@tt/contracts": "workspace:*",
    "@tt/messaging": "workspace:*",
    "fastify": "^5.12.8",
    "fastify-type-provider-zod": "^7.0.0",
    "node-pg-migrate": "^9.0.0",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1",
    "openapi-types": "^12.1.3",
    "testcontainers": "^12.2.1",
    "tsx": "^4.23.15",
    "yaml": "^2.9.1"
  }
}
