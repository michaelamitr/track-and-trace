# Copy this file to .env and set your own values: cp .env.example .env
# .env is not committed (it is listed in .gitignore).

# Superuser password for the local Postgres (user: postgres).
POSTGRES_PASSWORD=change-me-postgres

# shipment_owner: owns shipment_db and its schema, runs migrations.
SHIPMENT_OWNER_PASSWORD=change-me-shipment-owner

# shipment_service: runtime role, can only read and write data.
SHIPMENT_SERVICE_PASSWORD=change-me-shipment-service

# Connection URLs for shipment_db. The passwords must match
# SHIPMENT_OWNER_PASSWORD and SHIPMENT_SERVICE_PASSWORD above and should use
# only letters and digits, because they are part of a URL.
# Used by `pnpm db:migrate` (runs migrations as shipment_owner).
SHIPMENT_MIGRATIONS_DATABASE_URL=postgres://shipment_owner:change-me-shipment-owner@localhost:5432/shipment_db
# Used by the Shipment Service at runtime (data only).
SHIPMENT_DATABASE_URL=postgres://shipment_service:change-me-shipment-service@localhost:5432/shipment_db

# Shipment Service runtime (defaults shown).
# NATS_URL=nats://localhost:4222
# PORT=3001
# HOST=127.0.0.1
